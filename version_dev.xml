<?xml version="1.0" encoding="utf-8"?>
<rss xmlns:upgrader="https://github.com/larryaasen/upgrader" version="2.0">
  <channel>
    <title>My App Updates</title>
    <link>https://example.com/</link>
    <description>Appcast for Upgrader</description>

    <item>
      <title>Version 2.0.0</title>

      <!-- Wajib: versi aplikasi terbaru -->
      <upgrader:version>2.0.0</upgrader:version>

      <!-- Wajib: minimum versi agar aplikasi kalian dianggap OUTDATED -->
      <upgrader:min_os_version>1.0.0</upgrader:min_os_version>

      <!-- Wajib: URL ke Play Store atau App Store -->
      <upgrader:store>
        https://play.google.com/store/apps/details?id=com.example.myapp
      </upgrader:store>

      <!-- OPTIONAL: catatan update -->
      <description>
        - New UI improvements
        - Performance enhancements
        - Bug fixes
      </description>
    </item>

  </channel>
</rss>
